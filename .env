# Read automatically by `docker compose up`. Committed on purpose as a working local template
# (matching the existing convention in this repo) — the values below are DEVELOPMENT ONLY.
#
# In production, override every secret here via your host's environment. Do not ship this file.

# Signing key for player tokens. Replace in production:  openssl rand -base64 48
AUTH_PRIVATE_KEY=dev-only-do-not-use-in-production-Ku8fJq2mWvRz7bXn4cTgYhLpAe6sDiOw
AUTH_ISSUER=werewolf-party
AUTH_AUDIENCE=werewolf-party

# Where the app is served. Change WEB_PORT if 8080 is already taken.
WEB_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080

DB_USERNAME=werewolf
DB_PASSWORD=werewolf
DB_NAME=werewolf

BUILD_CONFIGURATION=Release

# Optional: Web Push for turn notifications. Leave blank and the app falls back to its in-app
# prompt. Generate a keypair with:  npx web-push generate-vapid-keys
PUSH_SUBJECT=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
